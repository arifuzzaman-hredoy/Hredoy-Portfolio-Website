# Copy to devops/.env and fill in real values. Do NOT commit devops/.env.

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# Both values are required to enable the /super-admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public site URL used for SEO and absolute links.
SITE_URL=https://oxytumzone.com