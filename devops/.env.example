# Copy to devops/.env and fill in real values. Do NOT commit devops/.env.

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# Both values are required to enable the /super-admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public site URL used for SEO and absolute links.
SITE_URL=https://oxytumzone.com

# Cloudinary media hosting (admin panel uploads go directly to Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=portfolio

# Contact form email notifications (optional). With these set, every contact
# message is also emailed to CONTACT_NOTIFY_TO. For Gmail use
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 and a Google App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_TO=

# Cloudflare edge purge (optional). With these set, an admin save also drops the
# cached HTML at the edge, so visitors see the edit immediately instead of after
# the edge TTL. The token needs Zone > Cache Purge permission for this zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=