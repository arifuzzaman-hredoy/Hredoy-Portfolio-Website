APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
DATABASE_URL=postgres://portfolio:portfolio@postgres:5432/portfolio?sslmode=disable

# Local run from backend/ uses this path; Docker uses file:///app/db/migrations
MIGRATION_PATH=file://../database/migrations

SITE_URL=https://oxytumzone.com

# Directory where uploaded media files are written and served from /uploads/*
UPLOAD_DIR=./uploads

# Super admin login at /super-admin (both values are required to enable login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Cloudinary media hosting (used by admin panel uploads and frontend scripts)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=portfolio

# On-demand cache revalidation. After an admin save the Go backend calls the
# Next.js frontend so edits appear within seconds instead of after the 60s ISR
# window. Both values are required; leave REVALIDATE_TOKEN empty to disable.
# The token is a shared secret between the two containers and is never logged.
# REVALIDATE_URL must stay on the internal Docker network, never a public URL.
REVALIDATE_URL=http://frontend:3000/api/revalidate
REVALIDATE_TOKEN=change-me-to-a-long-random-string

# Contact form email notifications. When these are set every contact message is
# also emailed to CONTACT_NOTIFY_TO (the visitor is set as Reply-To). Leave
# them empty to only store messages in the database and admin inbox.
# For Gmail, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 and SMTP_PASSWORD must be
# an App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_TO=
